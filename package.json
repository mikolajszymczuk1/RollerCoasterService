{
  "name": "rollercoaster-service",
  "version": "1.0.0",
  "description": "Backend service for rollercoaster system",
  "main": "app/server.ts",
  "scripts": {
    "start": "ENV_TYPE='local' npx npm-run-all --parallel dev:server dev:build",
    "build:prod": "webpack build --progress --color",
    "dev:build": "webpack --watch",
    "dev:server": "webpack && nodemon \"./dist/server.js\" --watch \"./dist\"",
    "preview": "ENV_TYPE='prod' node dist/server.js",
    "test:unit": "ENV_TYPE='test' jest --testMatch '<rootDir>/src/tests/unit/**/*.spec.ts' --silent --detectOpenHandles --workerIdleMemoryLimit=512MB --passWithNoTests",
    "test:integration": "ENV_TYPE='test' jest --testMatch '<rootDir>/src/tests/integration/**/*.spec.ts' --silent --detectOpenHandles --workerIdleMemoryLimit=512MB --passWithNoTests",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"./**/*.+(js|ts)\"",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js, ts}": [
      "eslint --quiet --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "keywords": [],
  "author": "Mikołaj Szymczuk",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.3",
    "class-transformer": "^0.5.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "husky": "^9.1.7",
    "inversify": "^6.2.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@rushstack/eslint-patch": "^1.10.4",
    "@swc/core": "^1.10.4",
    "@swc/jest": "^0.2.37",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^6.0.2",
    "@types/webpack-node-externals": "^3.0.4",
    "@typescript-eslint/parser": "^8.19.0",
    "clean-webpack-plugin": "^4.0.0",
    "commitlint": "^19.6.1",
    "compression-webpack-plugin": "^11.1.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.3.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "swc-loader": "^0.2.6",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "peerDependencies": {
    "@commitlint/lint": ">=7.6.0"
  }
}
